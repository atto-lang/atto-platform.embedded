// Pure Oreslang scalar reference models; these do not call platform native APIs.
import class TestCase, TestSuite, TestOptions, TestOutcome, RunSummary from "ores.std/testing";
import fnc expect_true, run_suite, require_success from "ores.std/testing";

fnc mailbox_has_room(int used, int capacity): bool {
  return used >= 0 && capacity > 0 && used < capacity;
}
fnc ring_next(int current, int capacity): int {
  if current + 1 == capacity; do
    return 0;
  fi
  return current + 1;
}

fnc mailbox_empty_can_admit(): TestOutcome {
  return expect_true(mailbox_has_room(0, 8), "mailbox_empty_can_admit reference assertion failed");
}
fnc mailbox_full_and_invalid_rejected(): TestOutcome {
  return expect_true(!mailbox_has_room(8, 8) && !mailbox_has_room(-1, 8) && !mailbox_has_room(0, 0), "mailbox_full_and_invalid_rejected reference assertion failed");
}
fnc ring_wraps_at_capacity(): TestOutcome {
  return expect_true(ring_next(7, 8) == 0 && ring_next(2, 8) == 3, "ring_wraps_at_capacity reference assertion failed");
}
pub routine main(): void {
  val TestSuite suite = new TestSuite("embedded-scalar-reference", arr[
    new TestCase("mailbox_empty_can_admit", mailbox_empty_can_admit, false, ""),
    new TestCase("mailbox_full_and_invalid_rejected", mailbox_full_and_invalid_rejected, false, ""),
    new TestCase("ring_wraps_at_capacity", ring_wraps_at_capacity, false, "")
  ]);
  val TestOptions options = new TestOptions("", false, true);
  val RunSummary summary = run_suite(rt borrow suite, rt borrow options);
  require_success(rt borrow summary);
  return;
}
